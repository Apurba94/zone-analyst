{
  "expo": {
    "name": "Zone Analyst",
    "slug": "pubgm-analyst",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "zoneanalyst",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0E1A22"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.CHANGEME.zoneanalyst",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.CHANGEME.zoneanalyst",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0E1A22"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}