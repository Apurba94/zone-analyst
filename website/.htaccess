# Zone Analyst — server settings for Hostinger (LiteSpeed / Apache).
# Upload this file together with the pages. macOS hides it because the name
# starts with a dot; Windows and Hostinger's File Manager show it normally.

# No directory listings (e.g. someone opening /downloads/ directly).
Options -Indexes
DirectoryIndex index.html

# Custom "not found" page.
# This path is correct when the site sits at the root of a domain or subdomain,
# which is the recommended setup. If you upload into a subfolder instead,
# change it to include the folder, e.g.  ErrorDocument 404 /zone/404.html
# and change <base href="/"> near the top of 404.html to match.
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet .xlsx
  AddType image/svg+xml .svg
  AddCharset utf-8 .html .css .js .svg
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Make the workbook download instead of opening in the browser.
  <FilesMatch "\.xlsx$">
    Header set Content-Disposition "attachment"
  </FilesMatch>
</IfModule>

# Pages refresh immediately after an upload; the stylesheet, scripts and icon
# are cached briefly so repeat visits are fast.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

# HTTPS: turn on "Force HTTPS" in hPanel (Security -> SSL) rather than
# redirecting here. A redirect in this file breaks the site if the SSL
# certificate has not finished installing yet.
